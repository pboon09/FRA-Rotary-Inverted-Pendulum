#include "led_matrix.h"
#include <stdlib.h>


/* Row pin mapping arrays */
static GPIO_TypeDef* const Row_Ports[LED_MATRIX_ROWS] = {
    C0_GPIO_Port, C1_GPIO_Port, C2_GPIO_Port, C3_GPIO_Port,
    C4_GPIO_Port, C5_GPIO_Port, C6_GPIO_Port, C7_GPIO_Port
};

static const uint16_t Row_Pins[LED_MATRIX_ROWS] = {
    C0_Pin, C1_Pin, C2_Pin, C3_Pin,
    C4_Pin, C5_Pin, C6_Pin, C7_Pin
};

void LED_Matrix_Init(LED_Matrix_Handle_t* hmatrix)
{
    /* Clear frame buffer */
    LED_Matrix_ClearBuffer(hmatrix);

    /* Initialize DM163 */
    LED_Matrix_Reset(hmatrix);
}


void LED_Matrix_Reset(LED_Matrix_Handle_t* hmatrix)
{
    /* Reset DM163 */
    HAL_GPIO_WritePin(RSTn_GPIO_Port, RSTn_Pin, GPIO_PIN_RESET);
    HAL_Delay(10);

    /* Initialize control pins */
    HAL_GPIO_WritePin(SCK_GPIO_Port, SCK_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(SDA_GPIO_Port, SDA_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(SB_GPIO_Port, SB_Pin, GPIO_PIN_RESET);

    /* Release reset */
    HAL_GPIO_WritePin(RSTn_GPIO_Port, RSTn_Pin, GPIO_PIN_SET);
    HAL_Delay(10);

    /* Clear all DM163 channels */
    for (int i = 0; i < LED_MATRIX_DM163_CHANNELS; i++) {
        LED_Matrix_SendData(hmatrix, 0x00);
    }

    /* Latch the data */
    LED_Matrix_LatchData(hmatrix);

    /* Turn off all rows (Common Anode - LOW = off) */
    LED_Matrix_DisableAllRows(hmatrix);
}


void LED_Matrix_DisableAllRows(LED_Matrix_Handle_t* hmatrix)
{
    for (int i = 0; i < LED_MATRIX_ROWS; i++) {
        HAL_GPIO_WritePin(Row_Ports[i], Row_Pins[i], GPIO_PIN_RESET);
    }
}


void LED_Matrix_EnableRow(LED_Matrix_Handle_t* hmatrix, uint8_t row)
{
    /* Disable all rows first */
    LED_Matrix_DisableAllRows(hmatrix);

    /* Small delay to ensure rows are off */
    for (volatile int i = 0; i < 100; i++);

    /* Enable the specific row */
    if (row < LED_MATRIX_ROWS) {
        HAL_GPIO_WritePin(Row_Ports[row], Row_Pins[row], GPIO_PIN_SET);
    }
}


void LED_Matrix_SendData(LED_Matrix_Handle_t* hmatrix, uint8_t data)
{
    DM163_SendByte(data);
}


void LED_Matrix_LatchData(LED_Matrix_Handle_t* hmatrix)
{
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_SET);
    HAL_Delay(1);
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
}

void LED_Matrix_UpdateFromAngle(LED_Matrix_Handle_t* hmatrix, LED_Matrix_Color_t color)
{
    /* Draw pendulum using stored angle */
    LED_Matrix_DrawPendulum(hmatrix, hmatrix->pendulum_angle, color);
}

void LED_Matrix_ClearBuffer(LED_Matrix_Handle_t* hmatrix)
{
    for (int row = 0; row < LED_MATRIX_ROWS; row++) {
        for (int col = 0; col < LED_MATRIX_COLS; col++) {
            hmatrix->frame_buffer[row][col][0] = 0; // R
            hmatrix->frame_buffer[row][col][1] = 0; // G
            hmatrix->frame_buffer[row][col][2] = 0; // B
        }
    }
}


void LED_Matrix_SetPixel(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col, LED_Matrix_Color_t color)
{
    if (row < LED_MATRIX_ROWS && col < LED_MATRIX_COLS) {
        hmatrix->frame_buffer[row][col][0] = color.r;
        hmatrix->frame_buffer[row][col][1] = color.g;
        hmatrix->frame_buffer[row][col][2] = color.b;
    }
}


void LED_Matrix_SetPixelRGB(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col, uint8_t r, uint8_t g, uint8_t b)
{
    LED_Matrix_Color_t color = {r, g, b};
    LED_Matrix_SetPixel(hmatrix, row, col, color);
}


LED_Matrix_Color_t LED_Matrix_GetPixel(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col)
{
    LED_Matrix_Color_t color = {0, 0, 0};

    if (row < LED_MATRIX_ROWS && col < LED_MATRIX_COLS) {
        color.r = hmatrix->frame_buffer[row][col][0];
        color.g = hmatrix->frame_buffer[row][col][1];
        color.b = hmatrix->frame_buffer[row][col][2];
    }

    return color;
}


void LED_Matrix_RefreshRow(LED_Matrix_Handle_t* hmatrix, uint8_t row)
{
    if (row >= LED_MATRIX_ROWS) return;

    /* Disable all rows first */
    LED_Matrix_DisableAllRows(hmatrix);
    LED_Matrix_Delay_us(5);

    /* Load row data to DM163 */
    DM163_LoadRowData(hmatrix, row);

    /* Enable this row */
    LED_Matrix_EnableRow(hmatrix, row);

    /* Display time */
    LED_Matrix_Delay_us(500);
}


void LED_Matrix_RefreshDisplay(LED_Matrix_Handle_t* hmatrix, uint16_t duration_ms)
{
    uint32_t start_time = HAL_GetTick();

    while ((HAL_GetTick() - start_time) < duration_ms) {
        for (uint8_t row = 0; row < LED_MATRIX_ROWS; row++) {
            LED_Matrix_RefreshRow(hmatrix, row);
        }
    }

    LED_Matrix_DisableAllRows(hmatrix);
}


void LED_Matrix_DrawLine(LED_Matrix_Handle_t* hmatrix, int x0, int y0, int x1, int y1, LED_Matrix_Color_t color)
{
    int dx = abs(x1 - x0);
    int dy = abs(y1 - y0);
    int sx = (x0 < x1) ? 1 : -1;
    int sy = (y0 < y1) ? 1 : -1;
    int err = dx - dy;

    while (1) {
        if (x0 >= 0 && x0 < LED_MATRIX_COLS && y0 >= 0 && y0 < LED_MATRIX_ROWS) {
            LED_Matrix_SetPixel(hmatrix, y0, x0, color);
        }

        if (x0 == x1 && y0 == y1) break;

        int e2 = 2 * err;
        if (e2 > -dy) {
            err -= dy;
            x0 += sx;
        }
        if (e2 < dx) {
            err += dx;
            y0 += sy;
        }
    }
}


void LED_Matrix_DrawCross(LED_Matrix_Handle_t* hmatrix, uint8_t center_row, uint8_t center_col, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);

    for (uint8_t row = 0; row < LED_MATRIX_ROWS; row++) {
        for (uint8_t col = 0; col < LED_MATRIX_COLS; col++) {
            if (row == center_row || col == center_col) {
                LED_Matrix_SetPixel(hmatrix, row, col, color);
            }
        }
    }
}


void LED_Matrix_DrawDiagonal(LED_Matrix_Handle_t* hmatrix, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);

    for (uint8_t i = 0; i < LED_MATRIX_ROWS; i++) {
        LED_Matrix_SetPixel(hmatrix, i, i, color);
    }
}


void LED_Matrix_DrawPendulum(LED_Matrix_Handle_t* hmatrix, float theta, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);

    /* Normalize angle to [0, 2π) */
    while (theta < 0.0f) theta += 2.0f * M_PI;
    while (theta >= 2.0f * M_PI) theta -= 2.0f * M_PI;

    /* Center point always on */
    LED_Matrix_SetPixel(hmatrix, LED_MATRIX_CENTER_ROW, LED_MATRIX_CENTER_COL, color);

    /* Draw line from center */
    for (int s = 1; s <= LED_MATRIX_PENDULUM_LEN; s++) {
        float xf = (float)LED_MATRIX_CENTER_COL + s * sinf(theta);
        float yf = (float)LED_MATRIX_CENTER_ROW - s * cosf(theta);

        int c = (int)lroundf(xf);
        int r = (int)lroundf(yf);

        /* Check bounds */
        if (c < 0 || c >= LED_MATRIX_COLS || r < 0 || r >= LED_MATRIX_ROWS)
            break;

        LED_Matrix_SetPixel(hmatrix, r, c, color);
    }
}


void LED_Matrix_AnimatePendulum(LED_Matrix_Handle_t* hmatrix, float* theta, float delta_theta)
{
    LED_Matrix_DrawPendulum(hmatrix, *theta, LED_MATRIX_COLOR_WHITE);
    LED_Matrix_RefreshDisplay(hmatrix, 50); // 50ms frame time

    *theta += delta_theta;
    if (*theta >= 2.0f * M_PI) *theta -= 2.0f * M_PI;
}


void LED_Matrix_Test_RowScan(LED_Matrix_Handle_t* hmatrix)
{
    for (int row = 0; row < LED_MATRIX_ROWS; row++) {
        LED_Matrix_DisableAllRows(hmatrix);
        HAL_Delay(10);

        /* Send all white data */
        HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(SB_GPIO_Port, SB_Pin, GPIO_PIN_SET);

        for (int i = 0; i < LED_MATRIX_DM163_CHANNELS; i++)
            LED_Matrix_SendData(hmatrix, 0xFF);

        LED_Matrix_LatchData(hmatrix);

        LED_Matrix_EnableRow(hmatrix, row);
        HAL_Delay(200);
    }

    LED_Matrix_DisableAllRows(hmatrix);
}


void LED_Matrix_Test_ColumnScan(LED_Matrix_Handle_t* hmatrix, uint8_t test_row)
{
    for (int col = 0; col < LED_MATRIX_COLS; col++) {
        LED_Matrix_DisableAllRows(hmatrix);
        LED_Matrix_Delay_us(5);

        HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(SB_GPIO_Port, SB_Pin, GPIO_PIN_SET);

        for (int c = 0; c < LED_MATRIX_COLS; c++) {
            uint8_t val = (c == col) ? 0xFF : 0x00;
            LED_Matrix_SendData(hmatrix, val); // ch1
            LED_Matrix_SendData(hmatrix, val); // ch2
            LED_Matrix_SendData(hmatrix, val); // ch3
        }

        LED_Matrix_LatchData(hmatrix);
        LED_Matrix_EnableRow(hmatrix, test_row);

        HAL_Delay(200);
    }

    LED_Matrix_DisableAllRows(hmatrix);
}


void LED_Matrix_Test_AllWhite(LED_Matrix_Handle_t* hmatrix)
{
    for (int row = 0; row < LED_MATRIX_ROWS; row++) {
        for (int col = 0; col < LED_MATRIX_COLS; col++) {
            LED_Matrix_SetPixel(hmatrix, row, col, LED_MATRIX_COLOR_WHITE);
        }
    }

    LED_Matrix_RefreshDisplay(hmatrix, 2000);
}


void LED_Matrix_Test_SingleLED(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);
    LED_Matrix_SetPixel(hmatrix, row, col, color);
    LED_Matrix_RefreshDisplay(hmatrix, 2000);
}


void LED_Matrix_Delay_us(uint32_t us)
{
    volatile uint32_t counter = us * (SystemCoreClock / 1000000U / 3U);
    while(counter--);
}


void DM163_SendByte(uint8_t data)
{
    /* Set SB HIGH for grayscale mode */
    HAL_GPIO_WritePin(SB_GPIO_Port, SB_Pin, GPIO_PIN_SET);

    for (volatile int i = 0; i < 10; i++);

    for (int i = 0; i < 8; i++) {
        /* Set data bit */
        if (data & 0x80) {
            HAL_GPIO_WritePin(SDA_GPIO_Port, SDA_Pin, GPIO_PIN_SET);
        } else {
            HAL_GPIO_WritePin(SDA_GPIO_Port, SDA_Pin, GPIO_PIN_RESET);
        }

        for (volatile int j = 0; j < 10; j++);

        /* Clock pulse */
        HAL_GPIO_WritePin(SCK_GPIO_Port, SCK_Pin, GPIO_PIN_SET);
        for (volatile int j = 0; j < 10; j++);
        HAL_GPIO_WritePin(SCK_GPIO_Port, SCK_Pin, GPIO_PIN_RESET);
        for (volatile int j = 0; j < 10; j++);

        data <<= 1;
    }
}


void DM163_LoadRowData(LED_Matrix_Handle_t* hmatrix, uint8_t row)
{
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(SB_GPIO_Port, SB_Pin, GPIO_PIN_SET);

    /* Send data for all 8 columns × 3 colors */
    for (uint8_t col = 0; col < LED_MATRIX_COLS; col++) {
        DM163_SendByte(hmatrix->frame_buffer[row][col][0]); // R
        DM163_SendByte(hmatrix->frame_buffer[row][col][1]); // G
        DM163_SendByte(hmatrix->frame_buffer[row][col][2]); // B
    }

    /* Latch data */
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_SET);
    LED_Matrix_Delay_us(2);
    HAL_GPIO_WritePin(LAT_GPIO_Port, LAT_Pin, GPIO_PIN_RESET);
    LED_Matrix_Delay_us(2);
}
