/* Private function prototypes -----------------------------------------------*/
static void DM163_SendByte(LED_Matrix_Handle_t* hmatrix, uint8_t data);
static void DM163_LoadRowData(LED_Matrix_Handle_t* hmatrix, uint8_t row);

/* Initialization functions --------------------------------------------------*/

/**
  * @brief  Initialize LED Matrix with configuration
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  config: Pointer to configuration structure
  * @retval None
  */
void LED_Matrix_Init(LED_Matrix_Handle_t* hmatrix, LED_Matrix_Config_t* config)
{
    /* Copy configuration */
    hmatrix->config = *config;

    /* Initialize pendulum angle */
    hmatrix->pendulum_angle = 0.0f;

    /* Clear frame buffer */
    LED_Matrix_ClearBuffer(hmatrix);

    /* Initialize DM163 */
    LED_Matrix_Reset(hmatrix);
}

/**
  * @brief  Reset DM163 and initialize to clean state
  * @param  hmatrix: Pointer to LED Matrix handle
  * @retval None
  */
void LED_Matrix_Reset(LED_Matrix_Handle_t* hmatrix)
{
    /* Reset DM163 */
    HAL_GPIO_WritePin(hmatrix->config.DM163_RST_Port, hmatrix->config.DM163_RST_Pin, GPIO_PIN_RESET);
    HAL_Delay(10);

    /* Initialize control pins */
    HAL_GPIO_WritePin(hmatrix->config.DM163_SCK_Port, hmatrix->config.DM163_SCK_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(hmatrix->config.DM163_SDA_Port, hmatrix->config.DM163_SDA_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(hmatrix->config.DM163_LAT_Port, hmatrix->config.DM163_LAT_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(hmatrix->config.DM163_SB_Port,  hmatrix->config.DM163_SB_Pin,  GPIO_PIN_RESET);

    /* Release reset */
    HAL_GPIO_WritePin(hmatrix->config.DM163_RST_Port, hmatrix->config.DM163_RST_Pin, GPIO_PIN_SET);
    HAL_Delay(10);

    /* Clear all DM163 channels */
    for (int i = 0; i < LED_MATRIX_DM163_CHANNELS; i++) {
        LED_Matrix_SendData(hmatrix, 0x00);
    }

    /* Latch the data */
    LED_Matrix_LatchData(hmatrix);

    /* Turn off all rows (Common Anode - LOW = off) */
    LED_Matrix_DisableAllRows(hmatrix);
}

/* Low-level control functions -----------------------------------------------*/

/**
  * @brief  Disable all rows (Common Anode configuration)
  * @param  hmatrix: Pointer to LED Matrix handle
  * @retval None
  */
void LED_Matrix_DisableAllRows(LED_Matrix_Handle_t* hmatrix)
{
    for (int i = 0; i < LED_MATRIX_ROWS; i++) {
        HAL_GPIO_WritePin(hmatrix->config.Row_Ports[i],
                         hmatrix->config.Row_Pins[i],
                         GPIO_PIN_RESET);
    }
}

/**
  * @brief  Enable specific row (Common Anode configuration)
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  row: Row number (0-7)
  * @retval None
  */
void LED_Matrix_EnableRow(LED_Matrix_Handle_t* hmatrix, uint8_t row)
{
    /* Disable all rows first */
    LED_Matrix_DisableAllRows(hmatrix);

    /* Small delay to ensure rows are off */
    for (volatile int i = 0; i < 100; i++);

    /* Enable the specific row */
    if (row < LED_MATRIX_ROWS) {
        HAL_GPIO_WritePin(hmatrix->config.Row_Ports[row],
                         hmatrix->config.Row_Pins[row],
                         GPIO_PIN_SET);
    }
}

/**
  * @brief  Send one byte to DM163
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  data: Data byte to send
  * @retval None
  */
void LED_Matrix_SendData(LED_Matrix_Handle_t* hmatrix, uint8_t data)
{
    DM163_SendByte(hmatrix, data);
}

/**
  * @brief  Latch data to DM163 outputs
  * @param  hmatrix: Pointer to LED Matrix handle
  * @retval None
  */
void LED_Matrix_LatchData(LED_Matrix_Handle_t* hmatrix)
{
    HAL_GPIO_WritePin(hmatrix->config.DM163_LAT_Port, hmatrix->config.DM163_LAT_Pin, GPIO_PIN_SET);
    HAL_Delay(1);
    HAL_GPIO_WritePin(hmatrix->config.DM163_LAT_Port, hmatrix->config.DM163_LAT_Pin, GPIO_PIN_RESET);
}

/* Frame buffer functions ----------------------------------------------------*/

/**
  * @brief  Clear frame buffer (all LEDs off)
  * @param  hmatrix: Pointer to LED Matrix handle
  * @retval None
  */
void LED_Matrix_ClearBuffer(LED_Matrix_Handle_t* hmatrix)
{
    for (int row = 0; row < LED_MATRIX_ROWS; row++) {
        for (int col = 0; col < LED_MATRIX_COLS; col++) {
            hmatrix->frame_buffer[row][col][0] = 0; // R
            hmatrix->frame_buffer[row][col][1] = 0; // G
            hmatrix->frame_buffer[row][col][2] = 0; // B
        }
    }
}

/**
  * @brief  Set pixel color in frame buffer
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  row: Row number (0-7)
  * @param  col: Column number (0-7)
  * @param  color: Color structure
  * @retval None
  */
void LED_Matrix_SetPixel(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col, LED_Matrix_Color_t color)
{
    if (row < LED_MATRIX_ROWS && col < LED_MATRIX_COLS) {
        hmatrix->frame_buffer[row][col][0] = color.r;
        hmatrix->frame_buffer[row][col][1] = color.g;
        hmatrix->frame_buffer[row][col][2] = color.b;
    }
}

/**
  * @brief  Set pixel color in frame buffer using RGB values
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  row: Row number (0-7)
  * @param  col: Column number (0-7)
  * @param  r: Red value (0-255)
  * @param  g: Green value (0-255)
  * @param  b: Blue value (0-255)
  * @retval None
  */
void LED_Matrix_SetPixelRGB(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col, uint8_t r, uint8_t g, uint8_t b)
{
    LED_Matrix_Color_t color = {r, g, b};
    LED_Matrix_SetPixel(hmatrix, row, col, color);
}

/**
  * @brief  Get pixel color from frame buffer
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  row: Row number (0-7)
  * @param  col: Column number (0-7)
  * @retval Color structure
  */
LED_Matrix_Color_t LED_Matrix_GetPixel(LED_Matrix_Handle_t* hmatrix, uint8_t row, uint8_t col)
{
    LED_Matrix_Color_t color = {0, 0, 0};

    if (row < LED_MATRIX_ROWS && col < LED_MATRIX_COLS) {
        color.r = hmatrix->frame_buffer[row][col][0];
        color.g = hmatrix->frame_buffer[row][col][1];
        color.b = hmatrix->frame_buffer[row][col][2];
    }

    return color;
}

/* Display refresh functions -------------------------------------------------*/

/**
  * @brief  Refresh single row from frame buffer
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  row: Row number (0-7)
  * @retval None
  */
void LED_Matrix_RefreshRow(LED_Matrix_Handle_t* hmatrix, uint8_t row)
{
    if (row >= LED_MATRIX_ROWS) return;

    /* Disable all rows first */
    LED_Matrix_DisableAllRows(hmatrix);
    LED_Matrix_Delay_us(5);

    /* Load row data to DM163 */
    DM163_LoadRowData(hmatrix, row);

    /* Enable this row */
    LED_Matrix_EnableRow(hmatrix, row);

    /* Display time */
    LED_Matrix_Delay_us(500);
}

/**
  * @brief  Refresh entire display from frame buffer
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  duration_ms: Duration to display in milliseconds
  * @retval None
  */
void LED_Matrix_RefreshDisplay(LED_Matrix_Handle_t* hmatrix, uint16_t duration_ms)
{
    uint32_t start_time = HAL_GetTick();

    while ((HAL_GetTick() - start_time) < duration_ms) {
        for (uint8_t row = 0; row < LED_MATRIX_ROWS; row++) {
            LED_Matrix_RefreshRow(hmatrix, row);
        }
    }

    LED_Matrix_DisableAllRows(hmatrix);
}

/* Drawing functions ---------------------------------------------------------*/

/**
  * @brief  Draw line using Bresenham's algorithm
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  x0, y0: Start coordinates
  * @param  x1, y1: End coordinates
  * @param  color: Line color
  * @retval None
  */
void LED_Matrix_DrawLine(LED_Matrix_Handle_t* hmatrix, int x0, int y0, int x1, int y1, LED_Matrix_Color_t color)
{
    int dx = abs(x1 - x0);
    int dy = abs(y1 - y0);
    int sx = (x0 < x1) ? 1 : -1;
    int sy = (y0 < y1) ? 1 : -1;
    int err = dx - dy;

    while (1) {
        if (x0 >= 0 && x0 < LED_MATRIX_COLS && y0 >= 0 && y0 < LED_MATRIX_ROWS) {
            LED_Matrix_SetPixel(hmatrix, y0, x0, color);
        }

        if (x0 == x1 && y0 == y1) break;

        int e2 = 2 * err;
        if (e2 > -dy) {
            err -= dy;
            x0 += sx;
        }
        if (e2 < dx) {
            err += dx;
            y0 += sy;
        }
    }
}

/**
  * @brief  Draw cross pattern
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  center_row: Center row
  * @param  center_col: Center column
  * @param  color: Cross color
  * @retval None
  */
void LED_Matrix_DrawCross(LED_Matrix_Handle_t* hmatrix, uint8_t center_row, uint8_t center_col, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);

    for (uint8_t row = 0; row < LED_MATRIX_ROWS; row++) {
        for (uint8_t col = 0; col < LED_MATRIX_COLS; col++) {
            if (row == center_row || col == center_col) {
                LED_Matrix_SetPixel(hmatrix, row, col, color);
            }
        }
    }
}

/**
  * @brief  Draw diagonal line
  * @param  hmatrix: Pointer to LED Matrix handle
  * @param  color: Line color
  * @retval None
  */
void LED_Matrix_DrawDiagonal(LED_Matrix_Handle_t* hmatrix, LED_Matrix_Color_t color)
{
    LED_Matrix_ClearBuffer(hmatrix);

    for (uint8_t i = 0; i < LED_MATRIX_ROWS; i++) {
        LED_Matrix_SetPixel(hmatrix, i, i, color);
    }
}

