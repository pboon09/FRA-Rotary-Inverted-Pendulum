#include "hc05.h"
#include <string.h>
#include <stdio.h>
#include <stdarg.h>
#include <ctype.h>

/* Private function prototypes */
static void HC05_ProcessReceivedByte(HC05_Handle_t *hhc05, uint8_t byte);
static void HC05_TrimLine(char *line);

/**
 * @brief Initialize HC-05 module
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @param huart: Pointer to UART handle
 * @param baudrate: Desired baud rate (e.g., 9600, 38400, 115200)
 */
void HC05_Init(HC05_Handle_t *hhc05, UART_HandleTypeDef *huart, uint32_t baudrate)
{
    /* Store UART handle */
    hhc05->huart = huart;

    /* Initialize buffers */
    memset(hhc05->rx_dma_byte, 0, HC05_RX_DMA_SIZE);
    memset(hhc05->line_buffer, 0, HC05_LINE_BUFFER_SIZE);
    memset(hhc05->tx_buffer, 0, HC05_TX_BUFFER_SIZE);

    /* Initialize state variables */
    hhc05->line_index = 0;
    hhc05->line_ready = 0;
    hhc05->tx_busy = 0;
    hhc05->command_callback = NULL;

    /* Configure UART baud rate */
    hhc05->huart->Init.BaudRate = baudrate;
    HAL_UART_Init(hhc05->huart);

    HAL_Delay(100);  // Allow HC-05 to stabilize
}

/**
 * @brief Set command processing callback
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @param callback: Function pointer to command processing callback
 */
void HC05_SetCommandCallback(HC05_Handle_t *hhc05, HC05_CommandCallback_t callback)
{
    hhc05->command_callback = callback;
}

/**
 * @brief Start receiving data via DMA
 * @param hhc05: Pointer to HC05_Handle_t structure
 */
void HC05_Start(HC05_Handle_t *hhc05)
{
    HAL_UART_Receive_DMA(hhc05->huart, hhc05->rx_dma_byte, HC05_RX_DMA_SIZE);
}

/**
 * @brief Send string via Bluetooth
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @param msg: Null-terminated string to send
 */
void HC05_Send(HC05_Handle_t *hhc05, const char *msg)
{
    uint16_t len = strlen(msg);
    if (len > HC05_TX_BUFFER_SIZE)
        len = HC05_TX_BUFFER_SIZE;

    /* Wait if previous DMA TX is still running */
    uint32_t timeout = HAL_GetTick() + 1000;  // 1 second timeout
    while (hhc05->tx_busy) {
        if (HAL_GetTick() > timeout) {
            return;  // Timeout - abort
        }
    }

    /* Copy message to TX buffer */
    memcpy(hhc05->tx_buffer, msg, len);

    /* Start DMA transmission */
    hhc05->tx_busy = 1;
    HAL_UART_Transmit_DMA(hhc05->huart, hhc05->tx_buffer, len);
}

/**
 * @brief Send formatted string via Bluetooth
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @param format: Printf-style format string
 * @param ...: Variable arguments
 */
void HC05_SendFormatted(HC05_Handle_t *hhc05, const char *format, ...)
{
    char buffer[HC05_TX_BUFFER_SIZE];
    va_list args;

    va_start(args, format);
    int len = vsnprintf(buffer, sizeof(buffer), format, args);
    va_end(args);

    if (len > 0 && len < HC05_TX_BUFFER_SIZE) {
        HC05_Send(hhc05, buffer);
    }
}

/**
 * @brief Process received data (call in main loop)
 * @param hhc05: Pointer to HC05_Handle_t structure
 */
void HC05_Process(HC05_Handle_t *hhc05)
{
    if (hhc05->line_ready) {
        hhc05->line_ready = 0;

        if (hhc05->command_callback != NULL) {
            hhc05->command_callback((char*)hhc05->line_buffer);
        }
    }
}

/**
 * @brief UART RX complete callback (call from HAL_UART_RxCpltCallback)
 * @param hhc05: Pointer to HC05_Handle_t structure
 */
void HC05_UART_RxCpltCallback(HC05_Handle_t *hhc05)
{
    uint8_t byte = hhc05->rx_dma_byte[0];

    /* Echo byte back (optional - can be disabled) */
    HAL_UART_Transmit(hhc05->huart, &byte, 1, 10);

    /* Process received byte */
    HC05_ProcessReceivedByte(hhc05, byte);

    /* Restart DMA for next byte */
    HAL_UART_Receive_DMA(hhc05->huart, hhc05->rx_dma_byte, HC05_RX_DMA_SIZE);
}

/**
 * @brief UART TX complete callback (call from HAL_UART_TxCpltCallback)
 * @param hhc05: Pointer to HC05_Handle_t structure
 */
void HC05_UART_TxCpltCallback(HC05_Handle_t *hhc05)
{
    hhc05->tx_busy = 0;
}

/**
 * @brief Check if a complete line is ready
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @return 1 if line is ready, 0 otherwise
 */
uint8_t HC05_IsLineReady(HC05_Handle_t *hhc05)
{
    return hhc05->line_ready;
}

/**
 * @brief Get pointer to received line buffer
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @return Pointer to line buffer
 */
char* HC05_GetLine(HC05_Handle_t *hhc05)
{
    return (char*)hhc05->line_buffer;
}

/**
 * @brief Clear line ready flag
 * @param hhc05: Pointer to HC05_Handle_t structure
 */
void HC05_ClearLine(HC05_Handle_t *hhc05)
{
    hhc05->line_ready = 0;
    hhc05->line_index = 0;
}

/* ============================================================================
 * Private Functions
 * ========================================================================== */

/**
 * @brief Process a single received byte
 * @param hhc05: Pointer to HC05_Handle_t structure
 * @param byte: Received byte
 */
static void HC05_ProcessReceivedByte(HC05_Handle_t *hhc05, uint8_t byte)
{
    /* Check for line ending */
    if (byte == '\n' || byte == '\r') {
        HC05_Send(hhc05, "\r");

        if (hhc05->line_index > 0) {
            hhc05->line_buffer[hhc05->line_index] = '\0';
            HC05_TrimLine((char*)hhc05->line_buffer);
            hhc05->line_ready = 1;
        }
        hhc05->line_index = 0;
    }
    else {
        /* Store character if buffer not full */
        if (hhc05->line_index < HC05_LINE_BUFFER_SIZE - 1) {
            hhc05->line_buffer[hhc05->line_index++] = byte;
        }
        else {
            /* Buffer overflow - reset */
            hhc05->line_index = 0;
        }
    }
}

/**
 * @brief Trim leading and trailing whitespace from line
 * @param line: String to trim (modified in place)
 */
static void HC05_TrimLine(char *line)
{
    /* Trim leading spaces */
    char *start = line;
    while (*start == ' ' || *start == '\t') start++;

    /* Shift string if needed */
    if (start != line) {
        memmove(line, start, strlen(start) + 1);
    }

    /* Trim trailing spaces */
    char *end = line + strlen(line) - 1;
    while (end > line && (*end == ' ' || *end == '\t')) {
        *end = '\0';
        end--;
    }
}
